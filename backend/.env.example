PORT=8000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# MongoDB is required by the API (Atlas or a local replica set).
MONGODB_URI=
MONGODB_DB=dr_manzar
NODE_ENV=development
# Render testing only: production + private-testing. Local defaults need none of these.
DEPLOYMENT_MODE=
MEDIA_STORAGE=local
FRONTEND_DIRECTORY=
TEST_ACCESS_USER=
TEST_ACCESS_PASSWORD=
# HTTPS email provider for Render Free (SMTP ports are blocked).
RESEND_API_KEY=
# Development mail is written to data/mail/ (contains sensitive one-time links).
MAIL_MODE=file
MAIL_FROM=Dr Manzar <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional 64-character hex key. Locally, a persistent key is generated in data/mfa.key.
# Keep this key backed up securely; changing/losing it prevents decryption of authenticator secrets.
MFA_ENCRYPTION_KEY=
# Local public cover derivatives only; never put paid book files in this directory.
COVER_DIRECTORY=./data/covers
# Public article/page narration only. Work directory is private; use the same volume.
AUDIO_DIRECTORY=./data/narration
AUDIO_WORK_DIRECTORY=./data/narration-work
# Optional maintained FFmpeg executable; defaults to the bundled development binary.
FFMPEG_PATH=
# Never expose this directory via static hosting or place it inside public media directories.
PRIVATE_BOOK_DIRECTORY=./data/private-books
